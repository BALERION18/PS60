# VajraX Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
#
# For Railway deployment: set these in the Railway dashboard
# (Variables tab of your service) — do NOT upload .env to Railway.

# =============================================================================
# DATABASE — Neon PostgreSQL
# Get your connection string from console.neon.tech
# =============================================================================
CLOUD_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require
EDGE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# =============================================================================
# JWT AUTHENTICATION
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================
CLOUD_JWT_SECRET=your_strong_random_secret_here
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# =============================================================================
# REDIS (optional — in-memory fallback used if unavailable)
# For Railway with no Redis plugin: leave unset or keep localhost
# For Upstash Redis: REDIS_URL=rediss://default:TOKEN@HOST:6380
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CORS — IMPORTANT: set this to your Vercel frontend URL in production
# =============================================================================
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# =============================================================================
# STATION IDENTITY
# =============================================================================
STATION_ID=maitri
STATION_IDS=maitri,bharati

# =============================================================================
# STATION PUBLIC KEYS (Production — Railway)
# Paste the PEM string for each station's Ed25519 public key.
# Replace actual newlines with \n so it fits on one line in the Railway dashboard.
# If not set, a throwaway keypair is generated at startup (dev/demo mode only).
# =============================================================================
# STATION_PUBKEY_MAITRI=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2Vw...\n-----END PUBLIC KEY-----
# STATION_PUBKEY_BHARATI=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2Vw...\n-----END PUBLIC KEY-----

# =============================================================================
# API PORTS (Railway uses $PORT automatically — these are for local dev only)
# =============================================================================
CLOUD_API_PORT=8200
EDGE_API_PORT=8100

# =============================================================================
# MQTT (DISABLED by default on Railway — set true only with a real broker)
# =============================================================================
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json          # Use 'json' for Railway log shipping, 'console' for local dev

# =============================================================================
# DEBUG
# =============================================================================
DB_ECHO=false
HEARTBEAT_TIMEOUT_MINUTES=15
