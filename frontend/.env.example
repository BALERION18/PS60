# VajraX Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit the actual .env.local file to git.

# =============================================================================
# API — Backend URL
# In local dev: leave empty, Vite proxies /api → http://127.0.0.1:8200
# In production: set this to your deployed Railway backend URL
# =============================================================================
VITE_API_BASE_URL=

# Example for production:
# VITE_API_BASE_URL=https://vajrax-backend.up.railway.app
