# VajraX — Environment Variables Reference
# ==========================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control (it's in .gitignore).
#
# Quick start:
#   cp .env.example .env
#   # Edit .env and fill in CLOUD_DATABASE_URL, EDGE_DATABASE_URL, CLOUD_JWT_SECRET
#   make db-setup        # Run migrations + seed data
#   make run-cloud       # Start Cloud backend on :8200
#   make run-edge        # Start Edge backend for Maitri on :8100


# =============================================================================
# DATABASE — Neon PostgreSQL
# =============================================================================
# Create two databases in your Neon project console (console.neon.tech):
#   1. vajrax_cloud   → paste connection string as CLOUD_DATABASE_URL
#   2. vajrax_edge    → paste connection string as EDGE_DATABASE_URL
#
# Connection string format (Neon):
#   postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Cloud / HQ database (NCPOR Goa — AI predictions, RBAC, logistics, history)
CLOUD_DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/vajrax_cloud?sslmode=require

# Edge simulation database (simulates on-station TimescaleDB during dev)
EDGE_DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/vajrax_edge?sslmode=require


# =============================================================================
# JWT AUTHENTICATION (Cloud only)
# =============================================================================
# Generate a strong secret with: make keygen-cloud-jwt
# Example output: CLOUD_JWT_SECRET=3f2a1b...64hex_chars...
CLOUD_JWT_SECRET=CHANGE_ME_run_make_keygen_cloud_jwt

JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7


# =============================================================================
# REDIS
# =============================================================================
# Used for: Edge outbound queue pub/sub, Cloud refresh token store, WebSocket pub/sub.
#
# Option A — Local Redis (install with: brew install redis && brew services start redis)
REDIS_URL=redis://localhost:6379/0
#
# Option B — Upstash Redis (cloud-hosted, no local process required)
# REDIS_URL=rediss://default:your_upstash_token@your-endpoint.upstash.io:6380


# =============================================================================
# STATION IDENTITY (Edge backend only)
# =============================================================================
# Which Antarctic research station this Edge instance serves.
# Values: maitri | bharati
STATION_ID=maitri

# Path to the per-station YAML configuration file
STATION_CONFIG_PATH=edge/config/maitri.yaml


# =============================================================================
# EDGE API SERVER
# =============================================================================
EDGE_API_PORT=8100
INGEST_MAX_BATCH_SIZE=500

# Alert deduplication: suppress duplicate alerts for this many seconds
ALERT_DEDUP_TTL_S=300

# Black-box recorder windows (seconds)
BLACK_BOX_PRE_EVENT_S=300        # 5 min capture before trigger
BLACK_BOX_POST_RESOLUTION_S=900  # 15 min capture after resolution
BLACK_BOX_FRAME_INTERVAL_S=10    # Seconds between black-box frames

# Outbound queue settings
QUEUE_MAX_BYTES=536870912   # 512 MB maximum queue size
QUEUE_RETENTION_DAYS=30


# =============================================================================
# CLOUD API SERVER
# =============================================================================
CLOUD_API_PORT=8200

# Comma-separated list of station IDs this Cloud instance serves
STATION_IDS=maitri,bharati

# Directory containing per-station Ed25519 PUBLIC keys
# File naming: {station_id}_public.pem
STATION_PUBKEY_DIR=infra/certs/stations

# Station declared offline after this many minutes of silence
HEARTBEAT_TIMEOUT_MINUTES=15


# =============================================================================
# MQTT BROKER (Edge ↔ Cloud sync transport)
# =============================================================================
# For local dev without TLS, install Mosquitto: brew install mosquitto
# For production: use the full TLS/mTLS setup in infra/certs/

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false

# TLS certificate paths (only needed when MQTT_USE_TLS=true)
# MQTT_CA_CERT_PATH=infra/certs/dev/ca.crt
# MQTT_CLIENT_CERT_PATH=infra/certs/dev/cloud.crt
# MQTT_CLIENT_KEY_PATH=infra/certs/dev/cloud.key


# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console    # console | json


# =============================================================================
# SIMULATOR (dev / testing only)
# =============================================================================
SIM_STATIONS=maitri,bharati
SIM_TICK_INTERVAL_S=5
SIM_LINK_SIM_ENABLED=true


# =============================================================================
# OBJECT STORAGE — MinIO / S3 (optional — for black-box archival)
# =============================================================================
# Only needed if you want black-box frames stored in object storage.
# Install MinIO locally: brew install minio/stable/minio
#
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=vajrax_minio
# MINIO_SECRET_KEY=minio_secret_dev
# MINIO_BUCKET_BLACKBOX=vajrax-blackbox
# MINIO_BUCKET_MODELS=vajrax-ai-models
# MINIO_USE_SSL=false


# =============================================================================
# DEBUG FLAGS
# =============================================================================
DB_ECHO=false   # Set to true to log all SQL statements (very verbose)
